#!/usr/bin/env bash
# --
# # Git Kv
# 
# ```
#            _ __     __
#     ____ _(_) /_   / /___   __
#    / __ `/ / __/  / //_/ | / /
#   / /_/ / / /_   / ,<  | |/ /
#   \__, /_/\__/  /_/|_| |___/
#  /____/
# ```



set -euo pipefail

GIT_KV_NOTES_REF="kv"
GIT_KV_DEFAULT_COMMIT="HEAD"
GIT_KV_DEFAULT_ORIGIN="origin"
GIT_KV_VERSION=""

function git_kvlib_get_version() {
	if [ -n "$GIT_KV_VERSION" ]; then
		printf '%s\n' "$GIT_KV_VERSION"
		return 0
	fi

	local script_dir
	script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
	if GIT_KV_VERSION="$(git -C "$script_dir/.." describe --tags --always --dirty 2>/dev/null)"; then
		printf '%s\n' "$GIT_KV_VERSION"
		return 0
	fi

	printf '%s\n' "dev"
}

function git_kv_version() {
	printf 'git-kv %s\n' "$(git_kvlib_get_version)"
}

GIT_OPTIONS=()
if [ -n "${GIT_AUTHOR_NAME:-}" ]; then
	GIT_OPTIONS+=("-c")
	GIT_OPTIONS+=("user.name=$GIT_AUTHOR_NAME")
fi
if [ -n "${GIT_AUTHOR_EMAIL:-}" ]; then
	GIT_OPTIONS+=("-c")
	GIT_OPTIONS+=("user.email=$GIT_AUTHOR_EMAIL")
fi
# It may happen that HOME is not defined, like in CI environments.
if [ -z "${HOME:-}" ] && [ ${#GIT_OPTIONS[@]} -eq 0 ]; then
	GIT_OPTIONS+=("-c")
	GIT_OPTIONS+=("user.name=git-kv")
	GIT_OPTIONS+=("-c")
	GIT_OPTIONS+=("user.email=git-kv@tools.internal")
fi

# -----------------------------------------------------------------------------
# 
# LIBRARY FUNCTIONS
# 
# -----------------------------------------------------------------------------

function git_kvlib_get_commit_hash() {
	local commit="${1:-$GIT_KV_DEFAULT_COMMIT}"
	local mode="${2:-write}"
	local commit_hash
	if commit_hash="$(git rev-parse --verify --quiet "$commit^{commit}")"; then
		echo "$commit_hash"
		return 0
	fi

	if [ "$mode" = "read" ] && [ "$commit" = "$GIT_KV_DEFAULT_COMMIT" ]; then
		return 2
	fi

	git rev-parse --verify "$commit^{commit}"
}

function git_kvlib_get_commit_hash_read() {
	local commit="${1:-$GIT_KV_DEFAULT_COMMIT}"
	local commit_hash
	local resolve_status=0
	if commit_hash="$(git_kvlib_get_commit_hash "$commit" read)"; then
		echo "$commit_hash"
		return 0
	else
		resolve_status=$?
	fi
	if [ "$resolve_status" -eq 2 ]; then
		return 0
	fi

	return "$resolve_status"
}

function git_kvlib_get_notes() {
	local commit="$1"
	git notes --ref="$GIT_KV_NOTES_REF" show "$commit" 2>/dev/null || true
}

function git_kvlib_set_notes() {
	local commit="$1"
	local content="$2"
	echo -n "$content" | git "${GIT_OPTIONS[@]}" notes --ref="$GIT_KV_NOTES_REF" add -f -F - "$commit"
}

function git_kvlib_raw_notes {
	local commit="${1:-$GIT_KV_DEFAULT_COMMIT}"
	local commit_hash
	commit_hash="$(git_kvlib_get_commit_hash_read "$commit")" || return $?
	if [ -z "$commit_hash" ]; then
		return 0
	fi

	GIT_NOTES_REF=refs/notes/$GIT_KV_NOTES_REF git log "$commit_hash" --pretty=format:"__HASH__ %h %aI %n%N"
}

function git_kvlib_dump_notes {
	local commit="${1:-$GIT_KV_DEFAULT_COMMIT}"
	git_kvlib_raw_notes "$commit" | grep -v '^__HASH__ \|^$'
}

function git_kvlib_key_matches() {
	local key="$1"
	local keyish="${2:-*}"
	[[ "$key" == $keyish ]]
}

function git_kvlib_format_output() {
	local format="$1"
	local data="$2"
	if [ "$format" = "json" ]; then
		echo "$data" | awk -F':' '
			BEGIN { printf "{"; first = 1 }
			NF > 1 { 
				if (!first) printf ",";
				first = 0;
				key = $1;
				value = substr($0, index($0, ":") + 1);
				gsub(/\\/, "\\\\", key);
				gsub(/\\/, "\\\\", value);
				gsub(/"/, "\\\"", key);
				gsub(/"/, "\\\"", value);
				gsub(/\t/, "\\t", key);
				gsub(/\t/, "\\t", value);
				gsub(/\r/, "\\r", key);
				gsub(/\r/, "\\r", value);
				printf "\"%s\":\"%s\"", key, value;
			}
			END { printf "}" }
		'
	else
		echo "$data"
	fi
}

# -----------------------------------------------------------------------------
# 
# SUBCOMMANDS
# 
# -----------------------------------------------------------------------------


function git_kv_show() {
	local format="text"
	local commit="$GIT_KV_DEFAULT_COMMIT"
	local show_raw="false"

	while [[ $# -gt 0 ]]; do
		case "$1" in
			-tjson) format="json"; shift ;;
			-traw)
				show_raw="true"
				shift
				;;
			*) commit="$1"; shift ;;

		esac
	done

	if [ "$show_raw" = "true" ]; then
		git_kvlib_raw_notes "$commit"
		return 0
	fi

	local lines=()
	local keys=()
	while read -r line; do
		local key="${line%%:*}"
		local value="${line#*:}"
		# NOTE: associative arrays would be better there
		case "${keys[*]}" in
			*"[$key]"*);;
			*)
				lines+=("$line")
				keys+=("[$key]")
				;;
		esac
	done < <(git_kvlib_dump_notes "$commit")
	local result
	result="$(printf '%s\n' "${lines[@]}")"
	git_kvlib_format_output "$format" "$result"
}

function git_kv_delete() {
	if [ "$#" -lt 1 ]; then
		echo "Usage: git kv delete KEY [COMMIT]" >&2
		return 1
	fi

	local key="$1"
	local commit="${2:-$GIT_KV_DEFAULT_COMMIT}"
	local commit_hash
	commit_hash=$(git_kvlib_get_commit_hash "$commit")
	local notes
	notes=$(git_kvlib_get_notes "$commit_hash")
	
	# Remove any existing entry for this key
	notes=$(printf '%s\n' "$notes" | awk -F':' -v key="$key" '$1 != key' || true)
	
	# TODO: We may want to instead remove the note.
	# Add the deletion entry
	if [ -z "$notes" ]; then
		notes="$(printf '%s:' "$key")"
	else
		notes="$(printf '%s\n%s:' "$notes" "$key")"
	fi
	
	git_kvlib_set_notes "$commit_hash" "$notes"
}

function git_kv_set() {
	local force="false"
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-f|--force) force="true"; shift ;;
			--) shift; break ;;
			-*)
				echo "Usage: git kv set [-f|--force] KEY VALUE [COMMIT]" >&2
				return 1
				;;
			*) break ;;
		esac
	done

	if [ "$#" -lt 2 ]; then
		echo "Usage: git kv set [-f|--force] KEY VALUE [COMMIT]" >&2
		return 1
	fi

	local key="$1"
	local value="$2"
	local commit="${3:-$GIT_KV_DEFAULT_COMMIT}"
	local commit_hash
	commit_hash=$(git_kvlib_get_commit_hash "$commit")

	if [ "$force" != "true" ]; then
		local current_value
		current_value="$(
			git_kv_show "$commit_hash" | awk -F':' -v key="$key" '$1 == key {print substr($0, index($0, ":") + 1); exit}'
		)"
		if [ -n "$current_value" ] && [ "$current_value" = "$value" ]; then
			return 0
		fi
	fi

	local notes
	notes=$(git_kvlib_get_notes "$commit_hash")
	
	# Remove any existing entry for this key
	notes=$(printf '%s\n' "$notes" | awk -F':' -v key="$key" '$1 != key' || true)
	
	# Add the new key-value pair
	if [ -z "$notes" ]; then
		notes="$(printf '%s:%s' "$key" "$value")"
	else
		notes="$(printf '%s\n%s:%s' "$notes" "$key" "$value")"
	fi
	git_kvlib_set_notes "$commit_hash" "$notes"
}

function git_kv_get() {
	if [ "$#" -lt 1 ]; then
		echo "Usage: git kv get KEY [COMMIT]" >&2
		return 1
	fi

	local keyish="${1:-*}"
	local commit="${2:-$GIT_KV_DEFAULT_COMMIT}"
	local commit_hash
	commit_hash="$(git_kvlib_get_commit_hash_read "$commit")" || return $?
	if [ -z "$commit_hash" ]; then
		return 0
	fi

	while read -r line; do
		local key="${line%%:*}"
		local value="${line#*:}"
		if git_kvlib_key_matches "$key" "$keyish"; then
			printf '%s\n' "$value"
		fi
	done < <(git_kv_show "$commit_hash")
}

function git_kv_get_all() {
	if [ "$#" -lt 1 ]; then
		echo "Usage: git kv get-all KEY [COMMIT]" >&2
		return 1
	fi

	local keyish="${1:-*}"
	local commit="${2:-$GIT_KV_DEFAULT_COMMIT}"
	local commit_hash
	commit_hash="$(git_kvlib_get_commit_hash_read "$commit")" || return $?
	if [ -z "$commit_hash" ]; then
		return 0
	fi

	while read -r line; do
		local key="${line%%:*}"
		local value="${line#*:}"
		if git_kvlib_key_matches "$key" "$keyish"; then
			printf '%s\n' "$value"
		fi
	done < <(git_kvlib_dump_notes "$commit_hash")
}

function git_kv_def() {
	if [ "$#" -lt 1 ]; then
		echo "Usage: git kv def KEY [COMMIT]" >&2
		return 1
	fi

	local keyish="${1:-*}"
	local commit="${2:-$GIT_KV_DEFAULT_COMMIT}"
	local info=""
	local key=""
	local commit_hash
	commit_hash="$(git_kvlib_get_commit_hash_read "$commit")" || return $?
	if [ -z "$commit_hash" ]; then
		return 0
	fi
	while read -r line; do
		if [[ "$line" == "__HASH__ "* ]]; then
			info=$(echo -n "$line" | cut -d' ' -f2-3)
		else
			key="${line%%:*}"
			if git_kvlib_key_matches "$key" "$keyish"; then
				echo  "$key $info"
			fi
		fi
	done < <(git_kvlib_raw_notes "$commit")
}

function git_kv_list() {
	local keyish="${1:-*}"
	local commit="${2:-$GIT_KV_DEFAULT_COMMIT}"
	local commit_hash
	commit_hash="$(git_kvlib_get_commit_hash_read "$commit")" || return $?
	if [ -z "$commit_hash" ]; then
		return 0
	fi

	while read -r line; do
		local key="${line%%:*}"
		local value="${line#*:}"
		if [ -n "$value" ] && git_kvlib_key_matches "$key" "$keyish"; then
			printf '%s\n' "$key"
		fi
	done < <(git_kv_show "$commit_hash") | sort | uniq || true
}

function git_kv_list_all() {
	local keyish="${1:-*}"
	local commit="${2:-$GIT_KV_DEFAULT_COMMIT}"
	local commit_hash
	commit_hash="$(git_kvlib_get_commit_hash_read "$commit")" || return $?
	if [ -z "$commit_hash" ]; then
		return 0
	fi

	while read -r line; do
		local key="${line%%:*}"
		if git_kvlib_key_matches "$key" "$keyish"; then
			printf '%s\n' "$key"
		fi
	done < <(git_kvlib_dump_notes "$commit_hash") | sort | uniq || true
}

function git_kv_items() {
	local keyish="${1:-*}"
	local commit="${2:-$GIT_KV_DEFAULT_COMMIT}"
	local commit_hash
	commit_hash="$(git_kvlib_get_commit_hash_read "$commit")" || return $?
	if [ -z "$commit_hash" ]; then
		return 0
	fi

	while read -r line; do
		local key="${line%%:*}"
		local value="${line#*:}"
		if [ -n "$value" ] && git_kvlib_key_matches "$key" "$keyish"; then
			printf '%s=%s\n' "$key" "$value"
		fi
	done < <(git_kv_show "$commit_hash")
}

function git_kv_push() {
	local origin="${1:-$GIT_KV_DEFAULT_ORIGIN}"
	git push "$origin" "refs/notes/$GIT_KV_NOTES_REF"
}

function git_kv_pull() {
	local origin="${1:-$GIT_KV_DEFAULT_ORIGIN}"
	git fetch "$origin" "refs/notes/$GIT_KV_NOTES_REF:refs/notes/$GIT_KV_NOTES_REF"
}


function git_kv_help() {
	cat << EOF
Usage: git kv <subcommand> [options]

git-kv is a key/value store that allows you to attach and retrieve
key/value data alongside your commits.

Available subcommands:
  show [COMMIT]              Show key-value pairs for the given commit
  del|delete KEY [COMMIT]    Delete a key for the given commit
  set [-f|--force] KEY VALUE [COMMIT]
                              Set a key-value pair for the given commit
  get KEY [COMMIT]           Get the latest value for a glob-matching key
  def KEY [COMMIT]           Show the commits that define glob-matching keys
  get-all KEY [COMMIT]       Get all values for a glob-matching key
  list KEYISH [COMMIT]       List keys matching the KEYISH glob for the given commit
  list-all KEYISH [COMMIT]   List keys matching the KEYISH glob, including deleted
  items [KEYISH] [COMMIT]    Output matching key=value pairs, one per line
  push [ORIGIN]              Push key-value data to the given origin
  pull [ORIGIN]              Pull key-value data from the given origin
  help                        Show this help text

Options:
  -h, --help                 Show this help text
  -v, --version              Show version information
  -tjson                     Output in JSON format (for applicable commands)

COMMIT defaults to the currently checked-out commit if not specified.
ORIGIN defaults to origin.
EOF
}

# -----------------------------------------------------------------------------
# 
# MAIN
# 
# -----------------------------------------------------------------------------

function git_kv_main() {
	local subcommand="${1:-}"
	if [ "_$subcommand" == "_" ]; then
		git_kv_help
		return 0
	fi
	shift
	case "$subcommand" in
		-h|--help) git_kv_help ;;
		-v|--version) git_kv_version ;;
		show) git_kv_show "$@" ;;
		del|delete) git_kv_delete "$@" ;;
		set) git_kv_set "$@" ;;
		get) git_kv_get "$@" ;;
		get-all) git_kv_get_all "$@" ;;
		def) git_kv_def "$@" ;;
		list) git_kv_list "$@" ;;
		list-all) git_kv_list_all "$@" ;;
		items) git_kv_items "$@" ;;
		push) git_kv_push "$@" ;;
		pull) git_kv_pull "$@" ;;
		h|help) git_kv_help ;;
		*) echo "Unknown subcommand: $subcommand" >&2; exit 1 ;;
	esac
}

# Entry point
git_kv_main "$@"

# EOF
